{
  "name": "streamdraft",
  "description": "Download videos from the page you are on. Browser-only, no helper program.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --coverage",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "lint:addon": "web-ext lint --source-dir .output/firefox-mv3",
    "check:licenses": "node scripts/check-licenses.ts",
    "smoke": "node tests/smoke/smoke.ts",
    "smoke:chrome": "node tests/smoke/chrome-smoke.ts",
    "testpage": "node tests/pages/server.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "selenium-webdriver": "^4.52.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "dependencies": {
    "mux.js": "6.3.0"
  }
}
